# ---- build outputs / logs ----
/build/
*.log

# ---- generated web bundles (built from src/) ----
app2/www/css/style.css
app2/www/js/app.js
app2/www/js/ui-demo.js
app2/www/ui-demo.html

# ---- scratch / local temp ----
/_scratch/
tests/.ts-out/
# AgentTeams 的团队状态（任务 / 邮箱 / 审批），属于本地状态，不入库
/.agent-teams/

# ---- toolchain: keep only authored scripts, ignore SDK downloads/extracts ----
/toolchain/*
!/toolchain/devserver.js
!/toolchain/make-icon.js
!/toolchain/check-bundle.mjs
!/toolchain/stress-stroke.mjs

# ---- self-contained web build deps (npm install in repo root) ----
node_modules/

# ---- signing key (secret) ----
**/debug.keystore

# ---- os junk ----
.DS_Store
Thumbs.db
