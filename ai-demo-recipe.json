[
  { "call": "call_tool", "args": { "id": "undo", "args": {} } },
  { "call": "turn_begin", "args": { "label": "画猫：坐在画布中央的橘猫（体素）" } },

  { "call": "call_tool", "args": { "id": "iso_set", "args": { "shape": "box", "w": 4, "d": 4, "h": 4, "tile": "4", "colorMode": "custom", "faceTop": "#f2b673", "faceRight": "#d98a3f", "faceLeft": "#a9611f", "outline": true, "shadow": "contact" } } },
  { "call": "call_tool", "args": { "id": "iso_origin", "args": { "at": [32, 34] } } },
  { "call": "call_tool", "args": { "id": "iso_generate", "args": {} } },

  { "call": "call_tool", "args": { "id": "iso_set", "args": { "shape": "box", "w": 1, "d": 1, "h": 3, "shadow": "off", "outline": true } } },
  { "call": "call_tool", "args": { "id": "iso_origin", "args": { "at": [40, 32] } } },
  { "call": "call_tool", "args": { "id": "iso_generate", "args": {} } },

  { "call": "call_tool", "args": { "id": "iso_set", "args": { "shape": "box", "w": 3, "d": 3, "h": 3, "colorMode": "custom", "faceTop": "#ffd9a3", "faceRight": "#e8a054", "faceLeft": "#c07c30", "shadow": "off", "outline": true } } },
  { "call": "call_tool", "args": { "id": "iso_origin", "args": { "at": [32, 24] } } },
  { "call": "call_tool", "args": { "id": "iso_generate", "args": {} } },

  { "call": "call_tool", "args": { "id": "iso_set", "args": { "shape": "wedge", "w": 1, "d": 1, "h": 2, "shadow": "off", "outline": true } } },
  { "call": "call_tool", "args": { "id": "iso_origin", "args": { "at": [28, 20] } } },
  { "call": "call_tool", "args": { "id": "iso_generate", "args": {} } },
  { "call": "call_tool", "args": { "id": "iso_origin", "args": { "at": [36, 20] } } },
  { "call": "call_tool", "args": { "id": "iso_generate", "args": {} } },

  { "call": "call_tool", "args": { "id": "iso_set", "args": { "shape": "box", "w": 1, "d": 1, "h": 1, "colorMode": "custom", "faceTop": "#fff1e8", "faceRight": "#f2d7c2", "faceLeft": "#d9b99f", "outline": false, "shadow": "off" } } },
  { "call": "call_tool", "args": { "id": "iso_origin", "args": { "at": [30, 31] } } },
  { "call": "call_tool", "args": { "id": "iso_generate", "args": {} } },

  { "call": "turn_commit", "args": {} },
  { "call": "digest" }
